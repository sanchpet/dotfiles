{
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "{{ .chezmoi.homeDir }}/.local/bin/statusline",
    "padding": 0,
    "refreshInterval": 5
  },
  "tui": "fullscreen",
  "theme": "dark",
  "skipDangerousModePermissionPrompt": true,
  "agentPushNotifEnabled": true,
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(screencapture:*)"
    ]
  },
  "sandbox": {
    "excludedCommands": [
      "screencapture"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.local/share/mise/shims/rtk hook claude"
          }
        ]
      }
    ]
  }
}
