{
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "{{ .chezmoi.homeDir }}/.local/bin/statusline",
    "padding": 0,
    "refreshInterval": 5
  },
  "tui": "fullscreen",
  "theme": "dark",
  "skipDangerousModePermissionPrompt": true,
  "agentPushNotifEnabled": true,
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(screencapture:*)"
    ],
    "deny": [
      "mcp__radar__apply_resource",
      "mcp__radar__patch_resource",
      "mcp__radar__manage_workload",
      "mcp__radar__manage_node",
      "mcp__radar__manage_rollout",
      "mcp__radar__manage_cronjob",
      "mcp__radar__manage_gitops"
    ]
  },
  "sandbox": {
    "excludedCommands": [
      "screencapture"
    ]
  },
{{- with .plugins }}
  "extraKnownMarketplaces": {{ .marketplaces | toJson }},
  "enabledPlugins": {{ .enabled | toJson }},
{{- end }}
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{ .chezmoi.homeDir }}/.local/share/mise/shims/rtk hook claude"
          }
        ]
      }
    ]
  }
}
