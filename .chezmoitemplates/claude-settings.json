{
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "{{ .chezmoi.homeDir }}/.local/bin/statusline",
    "padding": 0,
    "refreshInterval": 5
  },
  "tui": "fullscreen",
  "theme": "dark",
  "skipDangerousModePermissionPrompt": true,
  "permissions": {
    "allow": [
      "Bash(screencapture:*)"
    ]
  },
  "sandbox": {
    "excludedCommands": [
      "screencapture"
    ]
  }
}
