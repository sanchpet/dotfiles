# Managed by chezmoi. Keys live in the machine's vault and are served over its SSH
# agent — IdentityAgent points ssh at that agent for every host, so nothing has to
# sit in ~/.ssh. Commit signing goes through ~/.local/bin/git-agent-sign, which
# forces the same socket for non-login shells.

# OrbStack's 'orb' host for its Linux machines. Must stay above any Host block.
Include ~/.orbstack/ssh/config

# Host-specific drop-ins, read before the catch-all below so they win on any keyword.
# What a corporate network looks like — bastions, ProxyJump chains, host names — is not
# publishable, so a work machine keeps ~/.ssh/conf.d/tv.conf outside this repository.
# A glob that matches nothing is not an error, so this line is inert elsewhere.
Include ~/.ssh/conf.d/*.conf

Host *
{{ if eq (dig "agent" "kind" "" .) "1password" -}}
	IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- else -}}
	# The cask build is unsandboxed and serves the socket from the real home. A sandboxed
	# App Store build would put it under ~/Library/Containers/com.bitwarden.desktop/Data.
	IdentityAgent ~/.bitwarden-ssh-agent.sock
{{- end }}
