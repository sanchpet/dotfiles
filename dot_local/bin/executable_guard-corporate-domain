#!/usr/bin/env python3
"""guard-corporate-domain — keep the personal Claude profile out of the employer's domain.

Company policy forbids using a personal AI subscription for work. That boundary does not run
between machines or even between repositories: the vault holding both the personal and the work
governance domains sits on the work laptop, so the line runs between directories inside one tree.
A boundary held only by the operator's attention leaks on an ordinary `cd`, so it is enforced here.

Registered as a PreToolUse hook for every account profile. It is a no-op under the work profile
and blocks under any other, including the unnamed default — fail closed, because a wrong allow
breaks a company policy while a wrong block only costs a restart in the right profile.

Protocol: the tool call arrives as JSON on stdin; exit 2 with a reason on stderr denies it.
"""
import json
import os
import sys

# Territory that belongs to the employer, relative to the home directory. Paths, not keywords:
# matching the word "employer" anywhere would block reading this repo's own README.
CORPORATE_PATHS = (
    "hypomnemata/.repos/employer",
    "hypomnemata/11-governance-work/employer",
    "hypomnemata/30-knowledge/engineering/employer",
    "hypomnemata/00-inbox/employer-onboarding.md",
    "hypomnemata/70-memory/work-employer.md",
)

# Distinctive path tails to look for inside a shell command, where paths arrive unresolved
# (`cd .repos/employer`) rather than as a tidy argument.
CORPORATE_FRAGMENTS = (
    ".repos/employer",
    "11-governance-work/employer",
    "30-knowledge/engineering/employer",
    "employer-onboarding",
    "work-employer",
)

CORPORATE_HOSTS = ("employer-domain.tv", "employer.com")

# Whole tool families that only ever reach the employer's systems.
CORPORATE_TOOL_PREFIXES = ("mcp__atlassian__",)

REASON = """This is the employer's domain, and you are in the personal Claude profile.

Company policy does not allow a personal AI subscription to be used for work, so this call is
blocked rather than merely discouraged. Start the session again with `claude-work` (which sets
CLAUDE_CONFIG_DIR to the work profile) and the same call will go through.

Touched: {hit}"""


def corporate_roots():
    home = os.path.expanduser("~")
    return tuple(os.path.join(home, p) for p in CORPORATE_PATHS)


def path_is_corporate(value):
    """True when `value` resolves inside corporate territory. Resolution is lexical: the file
    need not exist yet (a Write creates it) and symlinks are deliberately not followed, so a
    link cannot be used to reach the territory under a different name."""
    if not value:
        return None
    resolved = os.path.normpath(os.path.join(os.getcwd(), os.path.expanduser(value)))
    for root in corporate_roots():
        if resolved == root or resolved.startswith(root + os.sep):
            return root
    return None


def first_hit(tool, tool_input):
    if any(tool.startswith(prefix) for prefix in CORPORATE_TOOL_PREFIXES):
        return "the employer's Atlassian workspace"

    for field in ("file_path", "notebook_path", "path"):
        hit = path_is_corporate(tool_input.get(field))
        if hit:
            return hit

    if tool == "Bash":
        command = tool_input.get("command", "")
        for fragment in CORPORATE_FRAGMENTS + CORPORATE_HOSTS:
            if fragment in command:
                return fragment

    url = tool_input.get("url", "")
    for host in CORPORATE_HOSTS:
        if host in url:
            return host

    return None


def main():
    profile = os.path.basename(os.environ.get("CLAUDE_CONFIG_DIR", "").rstrip("/"))
    if profile == ".claude-work":
        return 0

    try:
        event = json.load(sys.stdin)
    except (json.JSONDecodeError, ValueError):
        return 0

    tool = event.get("tool_name", "")
    tool_input = event.get("tool_input") or {}
    if not isinstance(tool_input, dict):
        return 0

    hit = first_hit(tool, tool_input)
    if hit:
        print(REASON.format(hit=hit), file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
