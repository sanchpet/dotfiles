#!/usr/bin/env node
// cdp-read — evaluate an expression in an open tab over CDP and write the string to stdout, the
// mirror of cdp-fill: a secret shown once on a page goes straight into a pipe.
//   cdp-read github.com/settings/personal-access-tokens 'document.getElementById("new-access-token").value' | gh secret set X
const [urlPart, expression] = process.argv.slice(2);
if (!urlPart || !expression) {
  console.error("usage: cdp-read <url-substring> <js-expression> | <consumer>");
  process.exit(2);
}
const port = process.env.CDP_PORT || "9222";

async function main() {
  const pages = await (await fetch(`http://127.0.0.1:${port}/json/list`)).json();
  const page = pages.find((p) => p.type === "page" && p.url.includes(urlPart));
  if (!page) throw new Error(`no open tab whose URL contains "${urlPart}"`);
  const ws = new WebSocket(page.webSocketDebuggerUrl);
  const value = await new Promise((resolve, reject) => {
    ws.onopen = () => ws.send(JSON.stringify({ id: 1, method: "Runtime.evaluate", params: { expression, returnByValue: true } }));
    ws.onmessage = (m) => {
      const msg = JSON.parse(m.data);
      if (msg.id === 1) resolve(msg.result?.result?.value);
    };
    ws.onerror = () => reject(new Error("CDP websocket error"));
  });
  ws.close();
  if (typeof value !== "string" || !value) throw new Error("expression returned no string");
  process.stdout.write(value);
  console.error(`cdp-read: ${value.length} chars from ${new URL(page.url).host}`);
}

main().catch((e) => {
  console.error(`cdp-read: ${e.message}`);
  process.exit(1);
});
