#!/usr/bin/python3
"""Supply ailine with subscription windows from the gateway's Codex account when the
session runs a Codex model; subscription sessions never show the API-cost segment."""

import fcntl
import hashlib
import json
import math
import os
from pathlib import Path
import subprocess
import sys
import time
import urllib.error
import urllib.request


STATE = Path.home() / ".local/state/codex-proxy"
TTL = 60
USAGE_URL = "https://chatgpt.com/backend-api/wham/usage"


def windows_from_usage(usage, now):
    windows = {}
    limits = usage.get("rate_limit") or {}
    for field in ("primary_window", "secondary_window"):
        window = limits.get(field) or {}
        name = {18000: "five_hour", 604800: "seven_day"}.get(
            window.get("limit_window_seconds")
        )
        used, reset = window.get("used_percent"), window.get("reset_at")
        if not name or not all(type(value) in (int, float) for value in (used, reset)):
            continue
        if not (math.isfinite(used) and math.isfinite(reset) and 0 <= used <= 100 and reset > now):
            continue
        windows[name] = {"used_percentage": used, "resets_at": reset}
    return windows


def fetch_usage(account):
    request = urllib.request.Request(USAGE_URL, headers={
        "Authorization": "Bearer " + account["access_token"],
        "ChatGPT-Account-Id": account["account_id"],
        "User-Agent": "codex_cli_rs/0.169.0",
    })
    with urllib.request.urlopen(request, timeout=3) as response:
        return json.load(response)


def quota(state=STATE):
    accounts = []
    for path in (state / "auth").glob("*.json"):
        account = json.loads(path.read_text())
        if account.get("type") == "codex" and not account.get("disabled"):
            accounts.append(account)
    if len(accounts) != 1:
        raise ValueError("expected exactly one active Codex account")
    account = accounts[0]
    scope = hashlib.sha256(account["account_id"].encode()).hexdigest()
    now = time.time()
    cache_path = state / "statusline-quota.json"
    with (state / "statusline-quota.lock").open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return {}
        try:
            cache = json.loads(cache_path.read_text())
        except (OSError, ValueError):
            cache = {}
        if cache.get("account") == scope and 0 <= now - cache.get("checked_at", 0) < TTL:
            return {name: window for name, window in cache.get("windows", {}).items()
                    if window["resets_at"] > now}
        try:
            windows = windows_from_usage(fetch_usage(account), now)
        except (OSError, ValueError, KeyError, TypeError) as error:
            # Cache failures too: a redraw every five seconds must not hammer the API.
            detail = "HTTP " + str(error.code) if isinstance(error, urllib.error.HTTPError) else type(error).__name__
            print("codex-statusline: quota unavailable (" + detail + ")", file=sys.stderr)
            windows = {}
        cache = {"account": scope, "checked_at": now, "windows": windows}
        temporary = cache_path.with_suffix("." + str(os.getpid()) + ".tmp")
        temporary.write_text(json.dumps(cache) + "\n")
        temporary.replace(cache_path)
        return windows


def main():
    os.umask(0o077)
    data = json.load(sys.stdin)
    model_field = data.get("model") or ""
    model = model_field if isinstance(model_field, str) else str(model_field.get("id") or "")
    codex_model = model.startswith(("gpt-", "codex", "o3", "o4"))
    if codex_model:
        try:
            data["rate_limits"] = quota()
        except (OSError, ValueError, KeyError, TypeError) as error:
            print("codex-statusline: quota unavailable (" + type(error).__name__ + ")", file=sys.stderr)
            data["rate_limits"] = {}
    args = ["ailine"]
    if codex_model or model.startswith(("kimi-", "k3")):
        # The platform status segment concerns Anthropic, not this inference provider.
        args.append("--no-status")
    # All gateway sessions run on subscriptions, where API-cost segments are meaningless.
    args += ["--cost", "false", *sys.argv[1:]]
    result = subprocess.run(args, input=json.dumps(data), text=True, check=False)
    raise SystemExit(result.returncode)


if __name__ == "__main__":
    main()
