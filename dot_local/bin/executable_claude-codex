#!/bin/sh
# Keep the personal transcript store while routing inference through local Codex OAuth.
set -eu
key_file="$HOME/.local/state/codex-proxy/api-key"
if [ ! -r "$key_file" ]; then
    echo 'Run codex-proxy -codex-login first, then start the codex-proxy login agent.' >&2
    exit 1
fi
unset ANTHROPIC_API_KEY CLAUDE_CODE_OAUTH_TOKEN
unset CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX CLAUDE_CODE_USE_FOUNDRY
export CLAUDE_CONFIG_DIR="$HOME/.claude-personal"
export ANTHROPIC_BASE_URL="http://127.0.0.1:8317"
ANTHROPIC_AUTH_TOKEN=$(cat "$key_file")
export ANTHROPIC_AUTH_TOKEN
model=${CLAUDE_CODEX_MODEL:-gpt-6.1-sol}
export ANTHROPIC_CUSTOM_MODEL_OPTION="$model"
export ANTHROPIC_CUSTOM_MODEL_OPTION_NAME="Codex ($model)"
export ANTHROPIC_DEFAULT_OPUS_MODEL="$model"
export ANTHROPIC_DEFAULT_SONNET_MODEL="$model"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="$model"
export CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1
exec claude --model "$model" "$@"
