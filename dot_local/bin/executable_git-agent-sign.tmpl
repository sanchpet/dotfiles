#!/bin/sh
# git commit/tag signing shim — route ssh-keygen to this machine's vault SSH agent,
# which serves the signing private key. Nothing signable is kept on disk.
#
# Interactive login shells get SSH_AUTH_SOCK pointed at the agent, but non-login
# shells (Claude Code, background agents, plain scripts) don't source ~/.zshrc and
# inherit the ambient agent, which lacks the vault key — `git commit -S` then fails
# with "Couldn't find key in agent". Git is pointed here via gpg.ssh.program, so
# signing works everywhere while ssh/push auth stays on whatever the environment
# provides (~/.ssh/config sets IdentityAgent for that).
#
# If the socket is absent (vault app closed or locked), fall through to the ambient
# agent rather than forcing a dead socket — the error then names the real cause.
{{ if eq (dig "agent" "kind" "" .) "1password" -}}
sock="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
{{- else -}}
# Socket path differs by build: an unsandboxed cask serves ~/.bitwarden-ssh-agent.sock, the
# App Store one serves it inside its sandbox container. Probe for one that answers rather than
# one that exists — switching builds leaves the previous socket file behind, and a mere -S test
# picks the dead one, which fails as "Couldn't get agent socket" with no hint why.
sock=""
for candidate in "$HOME/.bitwarden-ssh-agent.sock" \
                 "$HOME/Library/Containers/com.bitwarden.desktop/Data/.bitwarden-ssh-agent.sock"; do
  [ -S "$candidate" ] || continue
  SSH_AUTH_SOCK="$candidate" ssh-add -l >/dev/null 2>&1
  rc=$?
  # 2 means "cannot connect"; 1 is a reachable agent holding no identities.
  [ "$rc" -eq 2 ] || { sock="$candidate"; break; }
done
{{- end }}
[ -S "$sock" ] && export SSH_AUTH_SOCK="$sock"

# Claude Code sessions sign with their own on-disk key (~/.ssh/agent_ed25519), so unattended
# commits never wait on the vault agent's approval prompt. Only `-Y sign` is rewritten: the key
# file replaces git's public-key temp file, and -U (key is in the agent) is dropped.
agent_key="$HOME/.ssh/agent_ed25519"
if [ -n "$CLAUDECODE" ] && [ -r "$agent_key" ] && [ "$1" = "-Y" ] && [ "$2" = "sign" ]; then
  n=$#
  while [ "$n" -gt 0 ]; do
    a=$1; shift; n=$((n - 1))
    case $a in
      -U) ;;
      -f) shift; n=$((n - 1)); set -- "$@" -f "$agent_key" ;;
      *) set -- "$@" "$a" ;;
    esac
  done
fi
exec ssh-keygen "$@"
