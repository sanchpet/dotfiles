#!/usr/bin/env bash
# login-agents — (re)load the launchd login agents this repo owns
# (~/Library/LaunchAgents/dev.sanchpet.*.plist).
#
# chezmoi lays the plists down as files, but launchd only learns about a new or edited one
# after a bootout/bootstrap cycle, so laying the file down is not enough on its own. This is
# the single place that cycle lives: the chezmoi run_onchange hook calls it whenever a plist
# changes, and bootstrap calls it again after `brew bundle`, because on a bare machine the
# apps an agent starts are installed after the dotfiles are applied.
#
# Idempotent — safe to run at any time; a missing plist directory is not an error.
set -euo pipefail

domain="gui/$(id -u)"
shopt -s nullglob
plists=("$HOME"/Library/LaunchAgents/dev.sanchpet.*.plist)

if (( ${#plists[@]} == 0 )); then
  echo "login-agents: no agents to load"
  exit 0
fi

for plist in "${plists[@]}"; do
  label="$(basename "$plist" .plist)"

  # bootout does not always finish before it returns: a job with a live process is torn down
  # asynchronously, so the label can still be in the domain a few milliseconds later. Bootstrapping
  # onto a label that is still there fails with a bare "Input/output error" that names neither the
  # label nor the cause, so wait for it to actually leave, and report the bootout error if it never does.
  bootout_error="$(launchctl bootout "$domain/$label" 2>&1 || true)"
  for _ in {1..50}; do
    launchctl print "$domain/$label" >/dev/null 2>&1 || break
    sleep 0.2
  done
  if launchctl print "$domain/$label" >/dev/null 2>&1; then
    echo "login-agents: $label would not boot out${bootout_error:+ — $bootout_error}" >&2
    exit 1
  fi

  launchctl bootstrap "$domain" "$plist"
  echo "login-agents: loaded $label"
done
