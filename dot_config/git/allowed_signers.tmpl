{{- /* Trusted SSH signing keys for verifying our own git commits (public keys only). */ -}}
{{- /* Each machine signs with its own key, held in its vault, so verifying commits made */ -}}
{{- /* on another machine needs that machine's pubkey listed here. Onboard a machine by  */ -}}
{{- /* appending its agent.signingKey value to $keys below.                              */ -}}
{{- /* List key type + blob only, never the trailing comment (it can carry a machine   */ -}}
{{- /* or user name); the principal below is what identifies the signer.               */ -}}
{{- $p := `petrov@sanch.pet namespaces="git"` -}}
{{- /* Order below: the work machine (1Password), signing@personal (Bitwarden, shared by  */ -}}
{{- /* machines on that agent), then an older machine key kept for verifying its history. */ -}}
{{- $keys := list
      "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINSCsm9B3frrCuWpHdF4U/wzKaUIgGqnv7tIeHJjf1XD"
      "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINnwqHSKmXOt1E0jPvBCAmxvpujzZrvPwDRk5Gvg83s+"
      "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIClhHPS1tykz5l1eFtbMgHxGzbF0Jn7dqwOVUofWv+Q5"
-}}
{{- $lines := list -}}
{{- range $keys -}}{{- $lines = append $lines (printf "%s %s" $p .) -}}{{- end -}}
{{- join "\n" $lines }}
