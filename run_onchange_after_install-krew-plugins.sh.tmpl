#!/bin/sh
# Bootstrap krew and the kubectl plugins that mise cannot declare. mise installs the krew
# *installer* — a binary named krew-<os>_<arch> — but `kubectl krew` only resolves a binary called
# kubectl-krew, which krew produces by installing itself into its own root. Without this step the
# tool is on the machine and still unusable, which is the worst of both.
#
# revision: 1  — bump to force a re-run after editing the list below.
#
# The index is the team's private one on the corporate GitLab; krew clones it through the system
# git, so the engineer's existing SSH key authenticates it and no token is stored anywhere. That
# also makes the step reachability-dependent: a machine off the VPN skips it with a message rather
# than failing the bootstrap, exactly as the Vault-backed registrations next door do.
#
# tv: the team kubectl toolbox — `kubectl tv clusters list` reads the cluster fleet registry, so a
# newly built cluster reaches this workstation without anyone editing a wiki page by hand.
set -eu

INDEX_NAME=tv
INDEX_URL=<private-index-url>
PLUGINS="tv/tv"

# Absolute shim path, not `command -v`: chezmoi runs this without the interactive shell's PATH,
# so mise's shims are not on it — the same reason the helm plugin script next door does this.
KREW_INSTALLER="$HOME/.local/share/mise/shims/krew"
[ -x "$KREW_INSTALLER" ] || { echo "krew: installer missing (mise not applied yet?) — skipping"; exit 0; }

# Self-install is the step that produces kubectl-krew; already done is the steady state.
if [ ! -x "$HOME/.krew/bin/kubectl-krew" ]; then
  "$KREW_INSTALLER" install krew
  echo "krew: bootstrapped into ~/.krew"
fi

KREW="$HOME/.krew/bin/kubectl-krew"

{{ if .work.email -}}
# Work machine only: the index and the plugins it serves are employer infrastructure.
if ! git ls-remote --exit-code "$INDEX_URL" HEAD >/dev/null 2>&1; then
  echo "krew: $INDEX_URL unreachable (off VPN?) — skipping the $INDEX_NAME index"
  exit 0
fi

if ! "$KREW" index list 2>/dev/null | awk 'NR > 1 { print $1 }' | grep -qx "$INDEX_NAME"; then
  "$KREW" index add "$INDEX_NAME" "$INDEX_URL"
  echo "krew: index $INDEX_NAME added"
fi

"$KREW" update >/dev/null 2>&1 || true
for plugin in $PLUGINS; do
  name="${plugin#*/}"
  if "$KREW" list 2>/dev/null | grep -qx "$name"; then
    "$KREW" upgrade "$name" 2>/dev/null || true
  else
    "$KREW" install "$plugin"
    echo "krew: $plugin installed"
  fi
done
{{- else }}
echo "krew: personal machine — no private index to add"
{{- end }}
