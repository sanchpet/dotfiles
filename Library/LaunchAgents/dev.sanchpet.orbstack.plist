<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.sanchpet.orbstack</string>

  <!-- launchd agents get the bare /usr/bin:/bin:/usr/sbin:/sbin PATH, so orb is called by
       absolute path. The guard keeps this a no-op on a machine where the cask is not
       installed yet (bootstrap applies dotfiles before `brew bundle`). -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>[ -x /usr/local/bin/orb ] &amp;&amp; exec /usr/local/bin/orb start</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/dev/null</string>
  <key>StandardErrorPath</key>
  <string>/dev/null</string>
</dict>
</plist>
