<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.sanchpet.tg-agent-runner</string>

  <!-- Answers allowlisted messages to the agent's Telegram account with one headless
       `claude -p` run each, so the agent reacts without a live session. The runner and
       its allowlist live in the vault (.claude/scripts/tg-inbox/); it talks to the
       dev.sanchpet.mcp-tg-agent daemon. The guard makes this a clean no-op on a machine
       without the vault or the claude binary, e.g. the work machine. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>runner="$HOME/hypomnemata/.claude/scripts/tg-inbox/tg_agent_runner.py"; claude="$HOME/.local/share/mise/installs/claude/latest/claude"; [ -r "$runner" ] &amp;&amp; [ -x "$claude" ] || exit 0; export TG_AGENT_CLAUDE="$claude" PATH="$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"; exec /usr/bin/python3 -u "$runner" &gt;&gt;"$HOME/Library/Logs/tg-agent-runner.log" 2&gt;&amp;1</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/dev/null</string>
  <key>StandardErrorPath</key>
  <string>/dev/null</string>
</dict>
</plist>
